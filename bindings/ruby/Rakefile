# frozen_string_literal: true

require "bundler/gem_tasks"
require "rake/testtask"
require "rb_sys/extensiontask"

GEMSPEC = Gem::Specification.load("demuxusb.gemspec")

RbSys::ExtensionTask.new("demuxusb", GEMSPEC) do |ext|
  ext.lib_dir = "lib/demuxusb"
end

Rake::TestTask.new(:test) do |t|
  t.libs << "test"
  t.test_files = FileList["test/**/test_*.rb"]
end

task test: :compile
task default: :test
